<Window x:Class="YunQiao.Cashier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="云桥收银 · YunQiao Cashier"
        Width="1280" Height="800" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <DockPanel Background="#F6FAF7">
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="32" Height="32" CornerRadius="9" Background="#43A047" Margin="0,0,10,0">
            <TextBlock Text="云" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="云桥收银" FontSize="16" FontWeight="SemiBold" Foreground="#1F2D24" />
            <TextBlock Text="YunQiao Cashier for Windows" FontSize="10" Foreground="#777777" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="正在启动…" Foreground="#2E7D32" FontSize="13" />
          <TextBlock x:Name="ConnectorStatusText" Text="打印连接器等待登录" Foreground="#777777" FontSize="10" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="刷新页面" Click="Reload_Click" />
          <Button Content="打印机设置" Click="Settings_Click" Background="#EAF7EE" Foreground="#2E7D32" BorderBrush="#A5D6A7" />
        </StackPanel>
      </Grid>
    </Border>
    <wv2:WebView2 x:Name="CashierWebView" DefaultBackgroundColor="White" />
  </DockPanel>
</Window>
