<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- YunQiao semantic color tokens -->
  <Color x:Key="PrimaryColor">#43A047</Color>
  <Color x:Key="PrimaryHoverColor">#388E3C</Color>
  <Color x:Key="PrimaryPressedColor">#2E7D32</Color>
  <Color x:Key="TextPrimaryColor">#1F2D24</Color>
  <Color x:Key="TextSecondaryColor">#526158</Color>
  <Color x:Key="CanvasColor">#F6FAF7</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="BorderColor">#DDE5DF</Color>
  <Color x:Key="SuccessColor">#2E7D32</Color>
  <Color x:Key="WarningColor">#9A6700</Color>
  <Color x:Key="DangerColor">#B3261E</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EAF7EE" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF7EE" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF7E0" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFF0EF" />
  <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#F1F4F2" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#88938C" />

  <Style x:Key="YunQiaoFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="2" BorderBrush="{StaticResource PrimaryPressedBrush}" BorderThickness="2" CornerRadius="8" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource YunQiaoFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="9">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.90" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource DisabledSurfaceBrush}" />
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="#F1C4C0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryPressedBrush}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,7" />
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />

  <Style x:Key="FormLabel" TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,7" />
  </Style>

  <Style x:Key="TextInput" TargetType="TextBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource YunQiaoFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="InputSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
              <Setter TargetName="InputSurface" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="InputSurface" Property="Background" Value="{StaticResource DisabledSurfaceBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource TextInput}" />

  <Style x:Key="YunQiaoComboBox" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource YunQiaoFocusVisual}" />
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource YunQiaoComboBox}" />

  <Style TargetType="CheckBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource YunQiaoFocusVisual}" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style x:Key="ReadOnlyField" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DisabledSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="PrinterListItem" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="80" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource YunQiaoFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="ItemSurface"
                  Padding="14,12"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ItemSurface" Property="Background" Value="#F7FAF8" />
              <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
              <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#9DCEA2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemSurface" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
