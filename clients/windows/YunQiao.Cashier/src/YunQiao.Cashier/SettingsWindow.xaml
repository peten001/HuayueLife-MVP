<Window x:Class="YunQiao.Cashier.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云桥打印机设置" Width="900" Height="620" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F6FAF7">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="打印机与设备" FontSize="22" FontWeight="SemiBold" Foreground="#1F2D24" />
      <TextBlock Text="业务小票继续使用后台模板；这里仅配置 Windows RAW 或 LAN 传输。" Foreground="#666666" Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="14" Padding="10" BorderBrush="#EEEEEE" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="添加 Windows 打印机" Click="AddWindows_Click" />
            <Button Content="添加 LAN 打印机" Click="AddLan_Click" />
            <Button Content="删除所选" Click="Delete_Click" Foreground="#B3261E" />
          </StackPanel>
          <ListBox x:Name="ProfilesList" DisplayMemberPath="DisplayName" SelectionChanged="ProfilesList_SelectionChanged" BorderThickness="0" />
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20" BorderBrush="#EEEEEE" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="145" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="启用" VerticalAlignment="Center" Margin="0,8" />
            <CheckBox x:Name="EnabledBox" Grid.Column="1" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="显示名称" VerticalAlignment="Center" Margin="0,8" />
            <TextBox x:Name="DisplayNameBox" Grid.Row="1" Grid.Column="1" Padding="9" />
            <TextBlock Grid.Row="2" Text="传输" VerticalAlignment="Center" Margin="0,8" />
            <ComboBox x:Name="TransportBox" Grid.Row="2" Grid.Column="1" Padding="7" IsEnabled="False" />
            <TextBlock Grid.Row="3" Text="Windows 打印机" VerticalAlignment="Center" Margin="0,8" />
            <ComboBox x:Name="WindowsPrinterBox" Grid.Row="3" Grid.Column="1" Padding="7" IsEditable="True" />
            <TextBlock Grid.Row="4" Text="LAN IP" VerticalAlignment="Center" Margin="0,8" />
            <TextBox x:Name="HostBox" Grid.Row="4" Grid.Column="1" Padding="9" />
            <TextBlock Grid.Row="5" Text="LAN Port" VerticalAlignment="Center" Margin="0,8" />
            <TextBox x:Name="PortBox" Grid.Row="5" Grid.Column="1" Padding="9" />
            <TextBlock Grid.Row="6" Text="纸宽" VerticalAlignment="Center" Margin="0,8" />
            <ComboBox x:Name="PaperBox" Grid.Row="6" Grid.Column="1" Padding="7" />
            <TextBlock Grid.Row="7" Text="用途 / Role" VerticalAlignment="Center" Margin="0,8" />
            <ComboBox x:Name="RoleBox" Grid.Row="7" Grid.Column="1" Padding="7" />
            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button Content="应用当前编辑" Click="ApplyEditor_Click" />
              <Button Content="测试打印" Click="TestPrint_Click" Background="#EAF7EE" Foreground="#2E7D32" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="ResultText" VerticalAlignment="Center" Foreground="#666666" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Click="Cancel_Click" />
        <Button Content="保存设置" Click="Save_Click" Background="#43A047" Foreground="White" BorderBrush="#2E7D32" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
