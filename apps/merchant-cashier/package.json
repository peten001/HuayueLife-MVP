{
  "name": "@huayue-life/merchant-cashier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:ui": "node scripts/capture-v2-final-review.mjs --verify-only",
    "test:ui:v2-final": "node scripts/capture-v2-final-review.mjs --verify-only",
    "test:ui:mobile-v2-isolated": "node scripts/verify-mobile-v2-isolated.mjs",
    "test:ui:summary-scroll": "node scripts/verify-summary-mobile-scroll.mjs",
    "test:ui:real-api": "node scripts/capture-real-api-ui.mjs --verify-only",
    "test:ui:canonical-v2": "node scripts/capture-canonical-state-v2-review.mjs",
    "test:perf:catalog-first-open": "node scripts/capture-catalog-first-open-performance.mjs",
    "test:watch": "vitest",
    "screenshots": "node scripts/capture-v2-final-review.mjs",
    "screenshots:real-api": "node scripts/capture-real-api-ui.mjs",
    "screenshots:v2-final": "node scripts/capture-v2-final-review.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "pinyin-pro": "^3.27.0",
    "pinia": "^2.2.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "6.0.6",
    "vitest": "^3.0.5",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "2.2.0"
  }
}
