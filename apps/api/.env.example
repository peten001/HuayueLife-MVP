NODE_ENV="development"
PORT=3001
DATABASE_URL="mysql://huayue:change-me@localhost:3307/huayue_life_mvp"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"
# Exact comma-separated browser origins. Native Android requests do not need one.
CORS_ALLOWED_ORIGINS="https://admin.huayueyouxuan.com,https://servicewechat.com"
PRINTING_TASK_CENTER_ENABLED="true"
PRINTING_AUTO_CREATE_ENABLED="false"
PRINTING_EXECUTION_ENABLED="false"
# Global emergency stop for Android terminal-executed LAN printing.
LAN_PRINTING_ENABLED="true"
# Temporary rollback switch for the retired server-side Socket/TCP printer path.
# Never enable together with PRINTING_AUTO_CREATE_ENABLED.
LEGACY_PRINTING_ENABLED="false"

# Server-side cloud printing. Credentials and device keys must never be sent
# to Merchant Admin or stored in Printer.connectionConfig.
CLOUD_PRINT_WORKER_ENABLED="false"
CLOUD_PRINT_POLL_INTERVAL_MS="5000"
CLOUD_PRINT_LEASE_TIMEOUT_MS="30000"
CLOUD_PRINT_MAX_BATCH="10"
CLOUD_PRINT_RESULT_TIMEOUT_MS="900000"
CLOUD_PRINT_PROVIDER_TIMEOUT_MS="8000"

FEIE_ENABLED="false"
FEIE_API_BASE_URL="https://api.feieyun.cn/Api/Open/"
FEIE_USER=""
FEIE_UKEY=""
# Optional server-only JSON map of printer SN to device key for onboarding verification.
FEIE_DEVICE_KEYS_JSON=""

YILIAN_ENABLED="false"
YILIAN_API_BASE_URL="https://open-api-os.10ss.net/v2/"
YILIAN_CLIENT_ID=""
YILIAN_CLIENT_SECRET=""
# Optional server-only JSON map of machine code to device key for onboarding verification.
YILIAN_DEVICE_KEYS_JSON=""
# Generate with: openssl rand -base64 48
TERMINAL_AUTH_PEPPER=""
TERMINAL_TOKEN_TTL_DAYS="365"
TERMINAL_TOKEN_RENEW_BEFORE_DAYS="30"
TERMINAL_JOB_POLL_SECONDS="5"
TERMINAL_HEARTBEAT_SECONDS="20"
WECHAT_APP_ID="your_app_id"
WECHAT_APP_SECRET="your_app_secret"
PUBLIC_QR_BASE_URL="https://api.example.com"
MINIAPP_QR_ENTRY_URL="https://example.com/scan"
SEED_MERCHANT_PASSWORD="ChangeMe123!"
