<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The official YunQiao mark is placed inside 72dp of the adaptive icon's
      108dp canvas. The source asset includes a small transparent inset, so
      its visible mark remains within the 66dp safe zone without distortion.
    -->
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center">
        <bitmap
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/yunqiao_launcher_mark" />
    </item>
</layer-list>
