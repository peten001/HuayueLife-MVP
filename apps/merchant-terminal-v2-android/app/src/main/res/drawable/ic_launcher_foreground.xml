<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The official maskable YunQiao artwork is placed inside 90dp of the
      adaptive icon's 108dp canvas. Its visible mark remains within the
      66dp adaptive safe zone without changing the artwork proportions.
    -->
    <item
        android:width="90dp"
        android:height="90dp"
        android:gravity="center">
        <bitmap
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/yunqiao_launcher_mark" />
    </item>
</layer-list>
